---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { sortItemsByDateDesc } from "../utils/helpers";
import PostCardPreview from "../components/PostCardPreview.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/pixeltrue-space-discovery.svg";
import ArrowRight from "../icons/ArrowRight.astro";

const allPosts = (await getCollection("blogs")).sort(sortItemsByDateDesc);
---

<MainLayout
  activePage="home"
  pageTitle={siteConfig.title + " | An Astro Personal Blog Template"}
>
  <div
    class="jumbo-banner flex flex-col sm:flex-row sm:items-center sm:justify-between w-full px-4 my-12 gap-6"
  >
    <div class="w-full sm:w-fit sm:max-w-1/2">
      {
        siteConfig.hero?.eyebrowText && (
          <span class="tag rounded-full text-xs px-2 py-0 border border-gray-500 kanit-light">
            {siteConfig.hero?.eyebrowText}
          </span>
        )
      }
      <h1 class="sigmar-ff leading-tight text-balance sm:pt-0!">
        {siteConfig.hero?.title}
      </h1>
      <p class="kanit-regular text-balance text-xs sm:text-base">
        {siteConfig.hero?.text}
      </p>
      <div
        class="flex flex-wrap items-center text-xs sm:text-base gap-x-2 gap-y-8 mt-3 sm:mt-12"
      >
        {
          siteConfig.hero?.actions?.map((action, index) => (
            <Button
              href={action.href}
              class={index === 0 ? "space-btn-filled" : "space-btn-outlined"}
            >
              {action.text}
            </Button>
          ))
        }
      </div>
    </div>
    <div class="w-full sm:w-fit sm:max-w-1/2">
      <Image
        class="cover-img"
        src={heroImage}
        alt={"Astronaut in space"}
        width={400}
        height={300}
      />
    </div>
  </div>

  <!-- More About Me Section -->
  <div class="page-content my-16">
    <div class="flex flex-col items-center justify-center w-full max-w-3xl mx-auto px-4">
      <h2 class="sigmar-ff text-balance pt-0! pb-8!">More About Me</h2>
      <div class="bg-gray-100 dark:bg-gray-800 rounded-lg p-8 w-full">
        <div class="space-y-4 kanit-regular text-sm sm:text-base">
          <p>
            <strong>🎓 Education:</strong> I'm currently studying Mathematics at the University of Waterloo, 
            where I'm building a strong foundation in analytical thinking and problem-solving.
          </p>
          <p>
            <strong>💡 Interests:</strong> I'm passionate about software development, AI applications, and deploying 
            intelligent systems at scale. Recently, I've been dipping my toes into design and product design to 
            better understand the principles of user satisfaction and create products people actually love.
          </p>
          <p>
            <strong>🚀 Recent Win:</strong> I just finished building a Resume Tailoring Tool that cuts resume 
            customization time from 30 minutes down to just 2 minutes—because who has time to manually tweak 
            resumes for every application?
          </p>
          <p>
            <strong>🛠️ Currently Working On:</strong> I'm building a research feedback tool that helps anyone 
            test their ideas and gather structured feedback. I've also recently joined UW Cube's project team, 
            where I'll be contributing to product design and development for a health tech project.
          </p>
        </div>
        <div class="mt-8">
          <Button href="/blog" class="space-btn-outlined">
            Read Blogs <ArrowRight class="w-5 h-5 fill-current ml-4" />
          </Button>
        </div>
      </div>
    </div>
  </div>

</MainLayout>