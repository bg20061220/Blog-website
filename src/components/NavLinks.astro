---
const {
  activePage,
  links,
  isMobileLink = false,
} = Astro.props as {
  activePage: string;
  links: { text: string; href: string }[];
  isMobileLink?: boolean;
};

// Get the site URL from astro config
const siteUrl = import.meta.env.SITE || '';
---

{
  links?.map((link) => {
    const classNames = [
      isMobileLink ? "close-menu" : "",
      activePage === link.text.toLowerCase()
        ? "text-space-red! dark:text-space-yellow!"
        : "",
    ]
      .join(" ")
      .trim();
    
    // Create proper absolute URL
    const href = link.href.startsWith('http') ? link.href : `${siteUrl}${link.href}`;
    
    return (
      <a class={classNames} href={href}>
        {link.text}
      </a>
    );
  })
}